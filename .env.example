# ==================================================
# VenturePulse — Environment Variables
# Copy this file to ".env" in the project root and fill in real values.
# NEVER commit the real ".env" file.
# ==================================================

# ---- Backend server ----
PORT=4000
NODE_ENV=development

# URL of the frontend dev server, used for CORS.
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example (local Postgres):   postgresql://postgres:postgres@localhost:5432/venturepulse?schema=public
# Example (hosted, e.g. Neon): postgresql://user:password@ep-example.neon.tech/venturepulse?sslmode=require
DATABASE_URL=

# ---- Authentication ----
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- AI provider ----
# Any OpenAI-compatible API key. Read ONLY on the backend — never exposed
# to frontend/React code.
OPENAI_API_KEY=
# Override to point at a different OpenAI-compatible provider (optional).
OPENAI_BASE_URL=https://api.openai.com/v1
# Override to use a different model (optional).
OPENAI_MODEL=gpt-4o-mini
